{
  "name": "devfill",
  "version": "1.0.1",
  "description": "Smart, lightning-fast dummy data form filler for modern web developers & QA engineers",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "tsc --noEmit && node scripts/build.js --target=chrome",
    "build:firefox": "tsc --noEmit && node scripts/build.js --target=firefox",
    "build:all": "tsc --noEmit && node scripts/build.js --target=all",
    "package": "node scripts/package.js --target=chrome",
    "package:firefox": "node scripts/package.js --target=firefox",
    "package:all": "node scripts/package.js --target=all",
    "generate-icons": "node scripts/generate-icons.js",
    "preview": "vite preview"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "form-filler",
    "dummy-data",
    "developer-tools",
    "react-forms",
    "vue-forms",
    "testing"
  ],
  "author": "Sakhawat",
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
